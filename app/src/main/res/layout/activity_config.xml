<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin_medium">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_large">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:tint="@color/on_surface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_title"
                android:textSize="22sp"
                android:textColor="@color/on_surface"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/margin_small" />
        </LinearLayout>

        <!-- 目标模板列表 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_templates"
            android:textSize="18sp"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/margin_small" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTemplates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="@dimen/margin_small" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTemplate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/config_add_template"
            android:layout_marginBottom="@dimen/margin_large"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="8dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- 匹配参数 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_match_params"
            android:textSize="18sp"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/margin_medium" />

        <!-- 匹配灵敏度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/margin_medium">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_sensitivity"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/seekSensitivity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="75" />

                <TextView
                    android:id="@+id/tvSensitivityValue"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="75"
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- 降采样比例 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_downsample"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerDownsample"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:entries="@array/downsample_options" />
        </LinearLayout>

        <!-- 帧率 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_fps"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerFps"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:entries="@array/fps_options" />
        </LinearLayout>

        <!-- 最大活跃模板数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_max_active"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerMaxActive"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:entries="@array/max_active_options" />
        </LinearLayout>

        <!-- 匹配算法 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/margin_large">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_algorithm"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerAlgorithm"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:entries="@array/algorithm_options" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- 滑动校准 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_calibration"
            android:textSize="18sp"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/margin_medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/margin_small">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_calib_x"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCalibX"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="1.00"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/margin_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_calib_y"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCalibY"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="1.00"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginBottom="@dimen/margin_large">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetCalib"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/config_reset"
                android:layout_marginEnd="@dimen/margin_small"
                style="@style/Widget.Material3.Button.OutlinedButton"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecalibrate"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/config_recalibrate"
                android:layout_marginStart="@dimen/margin_small"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
