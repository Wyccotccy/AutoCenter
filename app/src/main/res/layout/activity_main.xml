<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="@dimen/margin_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textColor="@color/on_surface"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/margin_large" />

        <!-- 状态 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_medium"
            android:text="@string/status_idle"
            android:textSize="16sp"
            android:textColor="@color/status_text"
            android:background="@drawable/status_bg"
            android:layout_marginBottom="@dimen/margin_medium" />

        <!-- 开启无障碍服务 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAccessibility"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_open_accessibility"
            android:layout_marginBottom="@dimen/margin_small"
            app:cornerRadius="8dp" />

        <!-- 上传目标图案 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadTemplate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_upload_template"
            android:layout_marginBottom="@dimen/margin_small"
            app:cornerRadius="8dp" />

        <!-- 滑动校准 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalibrate"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_calibrate"
            android:layout_marginBottom="@dimen/margin_small"
            app:cornerRadius="8dp" />

        <!-- 测试匹配 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestMatch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="@string/btn_test_match"
            android:layout_marginBottom="@dimen/margin_small"
            app:cornerRadius="8dp" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="@dimen/margin_medium" />

        <!-- 显示瞄准框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_small">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/switch_show_reticle"
                android:textSize="16sp"
                android:textColor="@color/on_surface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchReticle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 启用自动居中 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/margin_small"
            android:layout_marginBottom="@dimen/margin_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/switch_auto_center"
                android:textSize="16sp"
                android:textColor="@color/on_surface" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 间距 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 底部配置按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="@dimen/margin_large">

            <ImageButton
                android:id="@+id/btnConfig"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_settings"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_config"
                android:tint="@color/on_surface" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
